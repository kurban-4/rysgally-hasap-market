{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rysgally-hasap-market",
  "version": "0.5.2",
  "identifier": "com.annagurban.rysgally-hasap-market",
  "build": {
    "beforeDevCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "resources": [
  "resources/rysgally-hasap-market/**/*",
  "resources/rysgally-hasap-market/server.php",
  "resources/rysgally-hasap-market/.env",
  "binaries/php.ini",
  "binaries/php-aarch64-apple-darwin",
  "binaries/php-x86_64-pc-windows-msvc/**/*"
],
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/annagurban/rysgally-hasap/releases/latest/download/latest.json"
      ],
      "pubkey": "RWQGoyosV2pIpN1nsc7pzzMMJLEj5gqkZF5yNBlktv7wfduk6yWX/J/o"
    }
  }
}
